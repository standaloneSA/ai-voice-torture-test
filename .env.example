# Copy this file to .env and fill in the keys you have. Leave a key blank to hide that provider.

# --- Text-to-speech providers ---
ELEVENLABS_API_KEY=
CARTESIA_API_KEY=
DEEPGRAM_API_KEY=
# OpenAI: the same key also enables "OpenAI Realtime" (gpt-realtime-2.1-mini, the tts-1 replacement; needs Node 22+)
OPENAI_API_KEY=
# Google Gemini: get a key in Google AI Studio (aistudio.google.com → Get API key)
GEMINI_API_KEY=

# --- Claude (writes test text and suggests IPA) ---
ANTHROPIC_API_KEY=
# Only needed if Claude says the key "is not scoped to a workspace".
# Find it in the Console under Settings → Workspaces (starts with wrkspc_).
# ANTHROPIC_WORKSPACE_ID=
# CLAUDE_MODEL=claude-haiku-5-5

# --- Server ---
PORT=5178
MAX_TEXT_CHARS=1500

# --- Public-demo protection (leave blank for local use) ---
# LIVE_MODE=off               # visitors can only play pre-recorded samples
# LIVE_PASSCODE=              # require a passcode for live generation
# DAILY_REQUESTS_PER_IP=20
# DAILY_CHAR_BUDGET=20000

# --- Testing ---
# MOCK_PROVIDER=1             # adds a fake "Test tone" provider that needs no key
# CARTESIA_DEMO_VOICE=        # voice id used by npm run build-demo
